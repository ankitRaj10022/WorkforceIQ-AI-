WORKFORCEIQ_CONFIG=production
FLASK_APP=run.py
APP_VERSION=3.0.0
COMPANY_NAME=WorkforceIQ
DEFAULT_ORGANIZATION_ID=org-demo
APP_DOMAIN=workforceiq.example.com
ACME_EMAIL=admin@example.com
WORKFORCEIQ_IMAGE=workforceiq-api:latest

# Generate different 64+ char values for both.
SECRET_KEY=replace-with-random-secret
JWT_SECRET_KEY=replace-with-different-random-secret
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_PASSWORD=replace-mysql-password

DATABASE_URL=mysql+pymysql://workforceiq:replace-mysql-password@db:3306/workforceiq
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

ENABLE_DEV_AUTH=false
MAX_CONTENT_LENGTH=10485760
MAX_EXPORT_ROWS=500
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BACKEND=redis
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
ML_STALE_DAYS=30
ELASTICSEARCH_URL=
BACKUP_DIRECTORY=backups

# Must match your real frontend origin/domain.
CORS_ORIGINS=https://workforceiq.example.com
LOG_LEVEL=INFO
STRUCTURED_LOGS=true
