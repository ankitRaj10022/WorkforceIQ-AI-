WORKFORCEIQ_CONFIG=development
FLASK_APP=run.py
FLASK_ENV=development
APP_VERSION=3.0.0
COMPANY_NAME=WorkforceIQ
DEFAULT_ORGANIZATION_ID=org-demo
SECRET_KEY=change-me-please-use-a-long-random-secret
JWT_SECRET_KEY=change-me-please-use-a-long-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000
DATABASE_URL=sqlite:///workforceiq.db
# Production MySQL example:
# DATABASE_URL=mysql+pymysql://workforceiq:workforceiq@localhost:3306/workforceiq
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
ENABLE_DEV_AUTH=true
MAX_CONTENT_LENGTH=10485760
MAX_EXPORT_ROWS=500
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BACKEND=auto
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
ML_STALE_DAYS=30
ELASTICSEARCH_URL=
BACKUP_DIRECTORY=backups
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=DEBUG
STRUCTURED_LOGS=true
