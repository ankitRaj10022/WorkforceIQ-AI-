WORKFORCEIQ_CONFIG=production
FLASK_APP=run.py
APP_VERSION=3.0.0
COMPANY_NAME=WorkforceIQ
DEFAULT_ORGANIZATION_ID=org-demo
SECRET_KEY=replace-with-64-plus-random-hex-characters
JWT_SECRET_KEY=replace-with-different-64-plus-random-hex-characters
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000
DATABASE_URL=mysql+pymysql://workforceiq:replace-password@mysql.example.com:3306/workforceiq
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
CELERY_CONCURRENCY=1
ENABLE_DEV_AUTH=false
MAX_CONTENT_LENGTH=10485760
MAX_EXPORT_ROWS=500
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BACKEND=redis
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
OIDC_ENABLED=false
OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example
OIDC_AUDIENCE=replace-with-cognito-app-client-id
OIDC_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example/.well-known/jwks.json
OIDC_JWKS_JSON=
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_REQUIRE_VERIFIED_EMAIL=true
OIDC_AUTO_PROVISION_USERS=false
OIDC_AUTO_PROVISION_DEFAULT_ROLE=EMPLOYEE
OIDC_AUTO_PROVISION_ALLOWED_EMAIL_DOMAINS=example.com
ML_STALE_DAYS=30
ELASTICSEARCH_URL=
BACKUP_DIRECTORY=backups
CORS_ORIGINS=https://app.example.com
LOG_LEVEL=INFO
STRUCTURED_LOGS=true
